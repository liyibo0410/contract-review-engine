# ============================================================
#  HengJian · Contract Review Agent  -  Environment Example
#  复制为 .env 后按需修改；所有项都有合理默认值，可全部留空运行
# ============================================================

# ---------- 服务 ----------
HJ_HOST=127.0.0.1
HJ_PORT=8130
# full = 完整模式（含回写等写操作）；demo = 演示只读模式（放宽 CORS，便于扫码访问）
HJ_ROLE=full

# ---------- 大模型（OpenAI 兼容协议）----------
# 留空 HJ_LLM_API_KEY 即自动降级为"规则模板生成器"，审查链路仍然完整可用
HJ_LLM_ENABLED=1
HJ_LLM_BASE_URL=https://api.deepseek.com/v1
HJ_LLM_API_KEY=
HJ_LLM_MODEL=deepseek-chat
# 超过该秒数即降级，不再等待 —— 演示现场不能卡在模型请求上
HJ_LLM_TIMEOUT=8
HJ_LLM_MAX_RETRY=1
HJ_LLM_TEMPERATURE=0
HJ_LLM_MAX_TOKENS=1600

# ---------- 文档解析 ----------
HJ_OCR_ENABLED=1
HJ_OCR_MIN_CONFIDENCE=0.60
# 平均置信度低于该值时直接判为 blocked（正文不可用）
HJ_OCR_BLOCK_THRESHOLD=0.35
# 解析后正文字数低于该值视为空文 -> blocked
HJ_MIN_TEXT_CHARS=120
HJ_MAX_UPLOAD_MB=30

# ---------- 回写 ----------
# 1 = 全局预览模式：只生成并暂存意见，绝不写入审批系统（评审彩排建议开启）
HJ_WRITEBACK_DRY_RUN=0
# 留空 = 使用内置审批系统模拟器；填写真实地址需同时实现 writeback._submit_to_platform
HJ_APPROVAL_SIM_BASE=

# ---------- 交付信息 ----------
HJ_TEAM=第X组
HJ_OWNER=李奕波
