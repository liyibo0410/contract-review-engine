<mxfile host="Electron" agent="Codex">
  <diagram id="contract-approval-architecture" name="合同审批助手项目">
    <mxGraphModel dx="3391" dy="2326" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3600" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
