        <mxCell id="s1_n1" parent="s1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=17;fontStyle=1;arcSize=10;spacing=8;" value="飞书审批待办" vertex="1">
          <mxGeometry height="70" width="170" x="30" y="80" as="geometry" />
        </mxCell>
        <mxCell id="s1_n2" parent="s1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=17;fontStyle=1;arcSize=10;spacing=8;" value="审批实例与合同附件" vertex="1">
          <mxGeometry height="70" width="170" x="235" y="80" as="geometry" />
        </mxCell>
        <mxCell id="s1_n3" parent="s1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=17;fontStyle=1;arcSize=10;spacing=8;" value="审查意见进入评论区" vertex="1">
          <mxGeometry height="70" width="170" x="440" y="80" as="geometry" />
        </mxCell>
        <mxCell id="s1_note" parent="s1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#064e3b;fontSize=15;spacing=12;arcSize=8;" value="&lt;b&gt;业务场景&lt;/b&gt;&lt;br&gt;这个项目面向企业合同审批场景，读取待审批合同和附件，抽取合同文本，识别合同风险，生成中文审查意见，并把审查意见写回审批评论区。最终审批结论仍由审批人决定。&lt;br&gt;&lt;br&gt;项目输出包括合同解析结果、风险命中情况、证据片段、风险等级、审查意见、评论回写状态和审计记录。业务人员可以在审批页面直接看到风险提示，研发和运营可以通过审计数据追踪每一次处理链路。" vertex="1">
          <mxGeometry height="185" width="590" x="25" y="420" as="geometry" />
        </mxCell>
        <mxCell id="s1_arch_1" parent="s1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=15;fontStyle=1;arcSize=10;spacing=8;" value="飞书审批&lt;br&gt;接入层" vertex="1">
          <mxGeometry height="70" width="120" x="25" y="195" as="geometry" />
        </mxCell>
        <mxCell id="s1_arch_2" parent="s1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=15;fontStyle=1;arcSize=10;spacing=8;" value="Hermes&lt;br&gt;编排层" vertex="1">
          <mxGeometry height="70" width="120" x="175" y="195" as="geometry" />
        </mxCell>
        <mxCell id="s1_arch_3" parent="s1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0ff;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=15;fontStyle=1;arcSize=10;spacing=8;" value="MCP&lt;br&gt;工具层" vertex="1">
