        <mxCell id="s1" parent="1" style="swimlane;html=1;startSize=44;rounded=0;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=20;fontStyle=1;container=1;collapsible=0;recursiveResize=0;" value="业务场景与整体架构" vertex="1">
